# Copy this file to .env and fill in what you have. Everything here has a
# sensible default except the secrets, which gcreelmap doctor will warn about
# until the phase that needs them.

# --- Paths ---
# DB_PATH=./data/gcreelmap.db
# DOWNLOAD_TEMP_DIR=./data/tmp
# LOCK_PATH=./data/run.lock

# --- Logging ---
# LOG_LEVEL=INFO   # one of DEBUG, INFO, WARNING, ERROR

# --- Extraction (P1) ---
# GEMINI_MODEL=gemini-3.5-flash
# MAX_VIDEO_DURATION_SECONDS=120
# YTDLP_COOKIES_FILE=            # a Netscape cookies.txt, e.g. exported for the burner IG account
# YTDLP_COOKIES_FROM_BROWSER=    # a browser name (e.g. "chrome"); wins over YTDLP_COOKIES_FILE if both are set

# --- Geocoding (P2) ---
# PLACES_MAX_LOOKUPS_PER_RUN=150
# PLACES_MAX_LOOKUPS_PER_DAY=300
# GEOCODE_CACHE_TTL_DAYS=30
# GEOCODE_NEGATIVE_TTL_DAYS=7
# PLACES_BIAS_RADIUS_M=50000
# See docs/cost-guardrails.md before the first real lookup.

# --- Secrets (each unlocks a later phase) ---
# TELEGRAM_BOT_TOKEN=   # needed from P4 (the Telegram bot)
# GEMINI_API_KEY=       # needed from P1 (reel extraction)
# GOOGLE_PLACES_API_KEY=  # needed from P2 (geocoding)
